---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  label: string;
  animate?: boolean;
  type?: "button" | "submit";
  class?: string;
}

const {
  href,
  variant = "primary",
  label,
  animate = true,
  type = "button",
  class: className = "",
} = Astro.props;

const baseClass =
  "inline-block px-[var(--space-m)] py-[var(--space-s)] rounded-full text-fs--1 font-medium no-underline";

const variantClasses = {
  primary: "bg-foreground text-background hover:opacity-90 transition-opacity",
  secondary:
    "text-foreground border border-border bg-background/90 hover:border-foreground hover:opacity-95 transition-colors",
  outline:
    "text-foreground border border-border hover:border-foreground hover:bg-foreground hover:text-background transition-colors",
};

const classes = [baseClass, variantClasses[variant], className]
  .filter(Boolean)
  .join(" ");

const letters = animate ? label.split("") : null;
const isLink = href != null;
---

{
  isLink ? (
    <a
      href={href}
      class:list={["relement-button", classes]}
      data-animate={animate}
    >
      {animate && letters ? (
        <span class="relement-button__text-wrap">
          <span class="relement-button__text-ghost" aria-hidden="true">
            {letters.map((char) => (
              <span
                class:list={[
                  "relement-button__letter-wrap",
                  char === " " && "relement-button__letter-wrap--space",
                ]}
              >
                <span class="relement-button__ghost-letter">
                  {char === " " ? "\u00A0" : char}
                </span>
              </span>
            ))}
          </span>
          <span class="relement-button__text">
            {letters.map((char) => (
              <span
                class:list={[
                  "relement-button__letter-wrap",
                  char === " " && "relement-button__letter-wrap--space",
                ]}
              >
                <span class="relement-button__letter">
                  {char === " " ? "\u00A0" : char}
                </span>
              </span>
            ))}
          </span>
        </span>
      ) : (
        <span class="relement-button__label">{label}</span>
      )}
    </a>
  ) : (
    <button
      type={type}
      class:list={["relement-button", classes]}
      data-animate={animate}
    >
      {animate && letters ? (
        <span class="relement-button__text-wrap">
          <span class="relement-button__text-ghost" aria-hidden="true">
            {letters.map((char) => (
              <span
                class:list={[
                  "relement-button__letter-wrap",
                  char === " " && "relement-button__letter-wrap--space",
                ]}
              >
                <span class="relement-button__ghost-letter">
                  {char === " " ? "\u00A0" : char}
                </span>
              </span>
            ))}
          </span>
          <span class="relement-button__text">
            {letters.map((char) => (
              <span
                class:list={[
                  "relement-button__letter-wrap",
                  char === " " && "relement-button__letter-wrap--space",
                ]}
              >
                <span class="relement-button__letter">
                  {char === " " ? "\u00A0" : char}
                </span>
              </span>
            ))}
          </span>
        </span>
      ) : (
        <span class="relement-button__label">{label}</span>
      )}
    </button>
  )
}

<style>
  .relement-button {
    overflow: hidden;
    text-align: center;
  }

  .relement-button__text-wrap {
    position: relative;
    display: inline-flex;
  }

  /* Onderlaag:zelfde letter-split als animatie, exacte spacing, 0.2 opacity */
  .relement-button__text-ghost {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    white-space: pre;
    margin: 0 -0.08em;
    opacity: 0.2;
    pointer-events: none;
    color: inherit;
  }

  .relement-button__ghost-letter {
    display: inline-block;
  }

  .relement-button__text {
    position: relative;
    z-index: 1;
    display: inline-flex;
    white-space: pre;
    margin: 0 -0.08em;
  }

  .relement-button__letter-wrap {
    display: inline-block;
    overflow: visible; /* animatie mag tot rand van button, niet afkappen */
    vertical-align: top;
  }

  .relement-button__letter-wrap--space {
    min-width: 0.25em; /* spatie neemt altijd ruimte in */
  }

  .relement-button__letter {
    display: inline-block;
    opacity: 1; /* default vol opacity; animatie speelt 0.4→1 tijdens roll */
  }

  /* Zonder animatie: geen extra wrapper nodig voor layout */
  .relement-button__label {
    display: inline-block;
  }
</style>

<script>
  import gsap from "gsap";

  function init() {
    const buttons = document.querySelectorAll(
      ".relement-button[data-animate='true']"
    );
    const stagger = 0.0125;
    const duration = 0.33;
    const ease = "power2.inOut";

    buttons.forEach((item) => {
      const letters = item.querySelectorAll(".relement-button__letter");
      if (!letters.length) return;

      const tl = gsap.timeline({ paused: true });

      tl.to(letters, {
        duration,
        yPercent: -200,
        opacity: 0,
        filter: "blur(12px)",
        scale: 3,
        ease,
        stagger,
      });
      tl.set(letters, {
        yPercent: 200,
        opacity: 0,
        scale: 3,
        filter: "blur(12px)",
      });
      tl.to(letters, {
        duration,
        yPercent: 0,
        opacity: 1,
        scale: 1,
        filter: "blur(0px)",
        ease: "power2.inOut",
        stagger,
      });

      item.addEventListener("mouseenter", () => tl.play(0));
    });
  }

  // Alleen via page-load: die vuurt ook bij de eerste load (ClientRouter).
  document.addEventListener("astro:page-load", init);
</script>

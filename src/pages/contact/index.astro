---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Relement">
  <article class="py-[var(--space-2xl)]">
    <p class="text-fs--1 text-muted mb-[var(--space-s)]">Contact</p>
    <h1
      class="text-fs-2 font-display font-medium text-foreground mb-[var(--space-m)] leading-tight"
    >
      Contact
    </h1>
    <p class="text-fs-0 text-foreground max-w-2xl mb-[var(--space-l)]">
      Interested in collaboration, funding, or our products? Get in touch.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--space-xl)] max-w-3xl">
      <address class="not-italic text-fs--1 text-foreground space-y-[var(--space-2xs)]">
        <p class="font-medium text-fs-0">Relement BV</p>
        <p>Auvergnedijk 2<br />4612 PZ Bergen op Zoom<br />Netherlands</p>
        <p>
          <a
            href="mailto:info@relement.eu"
            class="border-b border-foreground hover:opacity-80"
          >
            info@relement.eu
          </a>
        </p>
        <p>
          <a
            href="https://www.linkedin.com/company/relement"
            class="border-b border-foreground hover:opacity-80"
            rel="noopener noreferrer"
            target="_blank"
          >
            LinkedIn
          </a>
        </p>
      </address>

      <dl class="text-fs--1 text-foreground space-y-[var(--space-s)]">
        <div>
          <dt class="text-muted">Chamber of Commerce</dt>
          <dd>KvK 78156629</dd>
        </div>
        <div>
          <dt class="text-muted">Tax registration</dt>
          <dd>BTW NL861283557B01</dd>
        </div>
        <div>
          <dt class="text-muted">Bank</dt>
          <dd>NL52 INGB 0674 5340 77</dd>
        </div>
      </dl>
    </div>

    <p class="mt-[var(--space-xl)]">
      <a
        href="mailto:info@relement.eu?subject=Contact%20Relement"
        class="text-fs--1 font-medium text-foreground border-b border-foreground hover:opacity-80"
      >
        Email us →
      </a>
    </p>
  </article>
</BaseLayout>

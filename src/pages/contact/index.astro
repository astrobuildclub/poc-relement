---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Relement">
  <article class="py-[var(--space-2xl)] md:py-[var(--space-2xl)]">
    <h1 class="text-fs-2 font-display font-medium text-foreground mb-[var(--space-m)]">Contact</h1>
    <p class="text-fs-0 text-foreground max-w-2xl mb-[var(--space-l)]">
      Company details, contact form and LinkedIn. Coming soon.
    </p>
    <a
      href="/"
      class="text-fs--1 font-medium text-foreground border-b border-foreground hover:opacity-80"
    >
      Back to homepage
    </a>
  </article>
</BaseLayout>

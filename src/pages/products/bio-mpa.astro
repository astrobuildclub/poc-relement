---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="bio MPA — Relement">
  <article class="py-[var(--space-2xl)] md:py-[var(--space-2xl)]">
    <h1
      class="text-fs-2 font-display font-medium text-foreground mb-[var(--space-m)]"
    >
      bio MPA
    </h1>
    <p class="text-fs-0 text-foreground max-w-2xl mb-[var(--space-l)]">
      Our first commercial product. Details, specs, and sample request form
      coming soon.
    </p>
    <a
      href="/contact"
      class="text-fs--1 font-medium text-foreground border-b border-foreground hover:opacity-80"
    >
      Request a sample
    </a>
  </article>
</BaseLayout>
